{
  "name": "ccreator",
  "displayName": "CCreator",
  "description": "Расширение для генерации компоненты согласно структуры",
  "version": "1.1.1",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "publisher": "AvtoBBus",
  "repository": "https://github.com/AvtoBBus/CCreator.git",
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ccreator.createStructure",
        "title": "CCreator - Создать структуру файлов и папок для компоненты"
      },
      {
        "command": "ccreator.editUserTemplates",
        "title": "CCreator - Редактировать пользовательские шаблоны"
      },
      {
        "command": "ccreator.snippets",
        "title": "CCreator - Редактировать сниппеты"
      },
      {
          "command": "ccreator.createThere",
          "title": "CCreator - Создать структуру здесь"
      },
      {
          "command": "ccreator.configFile",
          "title": "CCreator - Настройка конфиг-файла"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "ccreator.createThere",
          "group": "navigation@100",
          "when": "explorerResourceIsFolder"
        }
      ]
    },
    "configuration": {
      "title": "CCreator",
      "properties": {
        "ccreator.showLivePreview": {
          "type": "boolean",
          "default": true,
          "description": "Включите, если хотите видеть отображение в виде дерева папок и файлов вводимую структуру"
        },
        "ccreator.historyLength": {
          "type":"number",
          "default": 5,
          "description": "Количество элементов сохраняемых в истории (default = 5)"
        },
        "ccreator.useLinter": {
          "type": "boolean",
          "default": true,
          "description": "Использовать линтер после генерации файла"
        },
        "ccreator.userTemplates": {
          "type": "array",
          "default": [
            {
              "templateName": "default",
              "structureString": "Comp.svelte:Comp.vue:Comp.tsx:Comp.jsx:Comp.component.ts",
              "fileContent": {
                "*.svelte": "<script lang='ts'>\n</script>\n\n<div></div>\n\n<style lang='scss'>\n</style>",
                "*.vue": "<template>\n<div>\n\n</div>\n</template>\n<script setup lang='ts'>\nimport { ref } from 'vue'\n\ndefineProps({ })\n</script>\n\n<style scoped lang='scss'}>\n.my-component {\npadding: 20px;\n}\n</style>",
                "*.tsx": "import React from 'react';\n\nconst Comp = () => {\nreturn <>\n</>\n};\n\nexport default Comp",
                "*.jsx": "import React from 'react';\n\nconst Comp = () => {\nreturn <>\n</>\n};\n\nexport default Comp",
                "*.component.ts": "import { Component, Input } from '@angular/core';\n\n@Component({\nselector: 'Comp',\nstandalone: true,\nimports: [],\ntemplate: '<div class='Comp'></div>',\nstyles: []\n})\nexport class Comp {}"
              }
            }
          ],
          "items": {
            "type": "object",
            "required": ["templateName", "structureString", "fileContent"],
            "properties": {
              "templateName": {
                "type": "string",
                "description": "Уникальное имя пресета (например, 'Svelte Component' или 'React Module')."
              },
              "structureString": {
                "type": "string",
                "default": "Comp.svelte:Comp.vue:Comp.tsx:Comp.jsx:Comp.component.ts",
                "description": "Строка структуры папок."
              },
              "fileContent": {
                "type": "object",
                "description": "Словарь файлов. Ключ — маска расширения (например, '*.svelte') или точное имя файла (например, 'index.ts'). Значение — контент файла.",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "description": "Укажите набор своих шаблонов, для более быстрой генерации структуры"
        },
        "ccreator.snippets": {
          "type": "array",
          "default": [
            {
              "snippetName": "CURENT_YEAR",
              "value": "() => new Date().getFullYear()"
            }
          ],
          "items": {
            "type": "object",
            "required": ["snippetName", "value"],
            "properties": {
              "snippetName": {
                "type": "string",
                "description": "Уникальное имя сниппета (например, 'CURENT_YEAR')."
              },
              "value": {
                "type": "string",
                "default": "() => new Date().getFullYear()",
                "description": "JavaScript-функция, которая выполняется и результат подставляет значение на место сниппета."
              }
            }
          },
          "description": "Укажите набор сниппетов, для использования при генерации структуры"
        }
      }
    }
  },
  
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
