{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "types": [
            "node",
            "mocha"
        ],
        "sourceMap": true,
        "rootDir": "src",
        "strict": true,
        "paths": {
            "$commands/*": [ "./src/commands/*" ],
            "$templates/*": [ "./src/templates/*" ],
            "$shared/*": [ "./src/shared/*" ],
        }
    },
    "include": ["src/**/*.d.ts", "src/**/*.ts", "src/**/*.js"],
}
